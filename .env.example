# ==========================================
# REVIEWZY ENVIRONMENT VARIABLES
# ==========================================

# 1. Supabase (Optional - offline/local storage works automatically if empty)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. OpenAI API Key (Optional - smart local synthesizer works automatically if empty)
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional custom base URL (e.g., OpenRouter, Groq, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1
